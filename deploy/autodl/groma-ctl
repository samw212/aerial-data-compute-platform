#!/usr/bin/env bash
# groma-ctl: the one command for running ADCP on an AutoDL instance.
#
#   groma-ctl status                  is everything running, and since when
#   groma-ctl health                  ask the service itself (database, redis, worker, disk)
#   groma-ctl start|stop|restart [program...]   all programs, or postgres redis api worker nginx
#   groma-ctl logs [program] [N]      last N lines (default api, 60)
#   groma-ctl follow [program]        watch a log live; Ctrl-C stops watching
#   groma-ctl update                  fetch the latest code, migrate, build, test, restart, smoke
#   groma-ctl smoke                   sign in through nginx and run a coverage; the end-to-end check
#   groma-ctl test                    run the test suite without touching the services
#   groma-ctl backup                  pg_dump + artefact manifest into backups/
#   groma-ctl restore <file.sql.gz>   restore a backup (stops the api and worker first)
#   groma-ctl backup-install          install the nightly backup (03:30) in cron
#   groma-ctl users list|add|passwd|role ...   manage sign-ins
#   groma-ctl disk [GB]               free space, and what a survey of GB needs to process
#   groma-ctl gpu                     what the GPU is and whether ODM will use it
#   groma-ctl where                   the paths and ports this install uses
#   groma-ctl help
set -euo pipefail

for candidate in "${GROMA_CTL_ENV:-}" /root/autodl-tmp/groma/run/env; do
  # shellcheck disable=SC1090
  [ -n "$candidate" ] && [ -f "$candidate" ] && source "$candidate" && break
done
GROMA_HOME="${GROMA_HOME:-/root/autodl-tmp/groma}"
GROMA_PORT="${GROMA_PORT:-6006}"
APP="$GROMA_HOME/app"; LOGS="$GROMA_HOME/logs"; RUN="$GROMA_HOME/run"; BACK="$GROMA_HOME/backups"
CONF="$RUN/supervisord.conf"
export PATH="$HOME/.local/bin:$PATH"
export GROMA_ENV_FILE=/etc/groma.env
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
PROGRAMS="postgres redis api worker nginx"

red()   { printf '\033[1;31m%s\033[0m\n' "$*"; }
green() { printf '\033[1;32m%s\033[0m\n' "$*"; }
sv()    { uv tool run --from supervisor supervisord "$@"; }
svc()   { uv tool run --from supervisor supervisorctl -c "$CONF" "$@"; }
supervisor_running() { [ -f "$RUN/supervisord.pid" ] && kill -0 "$(cat "$RUN/supervisord.pid")" 2>/dev/null; }
progs() { if [ $# -gt 0 ]; then printf 'groma:%s ' "$@"; else echo "groma:*"; fi; }

cmd_start() {
  if supervisor_running; then
    # shellcheck disable=SC2046
    svc start $(progs "$@") >/dev/null 2>&1 || true
  else
    sv -c "$CONF"; sleep 3
    if [ $# -gt 0 ]; then
      # Only the named programs: stop the rest that autostarted.
      for p in $PROGRAMS; do case " $* " in *" $p "*) ;; *) svc stop "groma:$p" >/dev/null 2>&1 || true ;; esac; done
    fi
  fi
  # supervisorctl status exits 3 when any program is stopped, which is expected
  # when only some programs were asked for; the listing is informational here.
  cmd_status || true
}
cmd_stop() {
  if ! supervisor_running; then echo "already stopped"; return; fi
  if [ $# -gt 0 ]; then svc stop $(progs "$@"); else svc stop 'groma:*' >/dev/null 2>&1 || true; svc shutdown >/dev/null 2>&1 || true; green "stopped"; fi
}
cmd_restart() {
  if ! supervisor_running; then cmd_start "$@"; return; fi
  # shellcheck disable=SC2046
  svc restart $(progs "$@"); sleep 2; cmd_status || true
}
cmd_status() {
  if supervisor_running; then svc status 'groma:*'; else red "not running (supervisord is not up). Start it with: groma-ctl start"; return 1; fi
}
cmd_health() {
  local tries=20 body
  for _ in $(seq "$tries"); do
    if body=$(curl -fsS --max-time 3 "http://127.0.0.1:$GROMA_PORT/api/health" 2>/dev/null); then
      green "healthy:"; echo "$body" | python3 -m json.tool 2>/dev/null || echo "$body"; return 0
    fi
    sleep 1
  done
  red "the service on port $GROMA_PORT is not answering (tried for ${tries}s). Try: groma-ctl logs api"; return 1
}
cmd_logs()   { local p="${1:-api}" n="${2:-60}"; [ -f "$LOGS/$p.log" ] || { echo "no log yet at $LOGS/$p.log"; return 0; }; tail -n "$n" "$LOGS/$p.log"; }
cmd_follow() { local p="${1:-api}"; echo "watching $LOGS/$p.log — press Ctrl-C to stop"; tail -n 20 -F "$LOGS/$p.log"; }
cmd_test() {
  cd "$APP"
  # shellcheck disable=SC1091
  set -a; . /etc/groma.env; set +a
  GROMA_TEST_DATABASE_URL="${GROMA_DATABASE_URL/\/groma/\/groma_test}" uv run pytest tests/unit tests/golden tests/integration -m "not slow and not bench"
}
cmd_update() {
  cd "$APP"
  local before after branch
  branch=$(git rev-parse --abbrev-ref HEAD); before=$(git rev-parse --short HEAD)
  git checkout -q -- uv.lock 2>/dev/null || true
  echo "fetching branch $branch ..."; git fetch --quiet origin "$branch"; git checkout --quiet -B "$branch" "origin/$branch"
  after=$(git rev-parse --short HEAD)
  [ "$before" = "$after" ] && echo "already up to date at $after" || { echo "updated $before -> $after"; git --no-pager log --oneline "$before..$after" | sed 's/^/    /'; }
  echo "installing ..."; GROMA_SKIP_TESTS=1 bash deploy/autodl/bootstrap.sh >"$LOGS/update.log" 2>&1 || { tail -30 "$LOGS/update.log"; red "update failed; see $LOGS/update.log"; red "roll back:  cd $APP && git checkout $before && bash deploy/autodl/bootstrap.sh"; return 1; }
  echo "testing ..."; cmd_test >"$LOGS/tests.log" 2>&1 && green "$(tail -1 "$LOGS/tests.log")" || { tail -20 "$LOGS/tests.log"; red "tests failed after update; see $LOGS/tests.log"; return 1; }
  cmd_smoke
}
cmd_smoke() {
  # Through nginx, as a browser would: config, sign-in, portfolio, a coverage run.
  local base="http://127.0.0.1:$GROMA_PORT" jar; jar=$(mktemp)
  curl -fsS "$base/api/config" >/dev/null || { red "config endpoint down"; return 1; }
  curl -fsS "$base/" | grep -q '<div id="root">' || { red "the web app is not being served"; return 1; }
  # shellcheck disable=SC1091
  set -a; . /etc/groma.env; set +a
  local email="${GROMA_SMOKE_EMAIL:-smoke@adcp.local}" pw
  pw="$(cd "$APP" && uv run groma users passwd "$email" 2>/dev/null | awk '{print $NF}')" \
    || pw="$(cd "$APP" && uv run groma users add "$email" "Smoke test" --role surveyor 2>/dev/null | awk '{print $NF}')"
  curl -fsS -c "$jar" -H 'Content-Type: application/json' -d "{\"email\":\"$email\",\"password\":\"$pw\"}" "$base/api/auth/login" >/dev/null || { red "sign-in failed"; rm -f "$jar"; return 1; }
  local org scen
  org=$(curl -fsS -b "$jar" "$base/api/auth/me" | python3 -c 'import sys,json; print(json.load(sys.stdin)["org_id"])')
  scen=$(curl -fsS -b "$jar" "$base/api/orgs/$org/venues" | python3 -c '
import sys,json; vs=json.load(sys.stdin); print(vs[0]["venue"]["id"] if vs else "")')
  [ -n "$scen" ] || { green "smoke ok (no venues to run coverage on)"; rm -f "$jar"; return 0; }
  scen=$(curl -fsS -b "$jar" "$base/api/venues/$scen/scenarios" | python3 -c 'import sys,json; s=json.load(sys.stdin); print(s[0]["id"] if s else "")')
  [ -n "$scen" ] || { green "smoke ok (no scenario yet)"; rm -f "$jar"; return 0; }
  curl -fsS -b "$jar" -H 'Content-Type: application/json' -d '{"grid_spacing_m":1.0}' "$base/api/scenarios/$scen/coverage" \
    | python3 -c 'import sys,json; r=json.load(sys.stdin); s=r["stats"]; print("smoke ok: coverage run %s kernel %s detect %.1f%% in %s ms" % (r["id"][:8], r["kernel_version"], 100*s["tier_area_m2"]["detect"]/s["area_m2"], r["duration_ms"]))'
  rm -f "$jar"
}
cmd_backup() {
  mkdir -p "$BACK"; local stamp; stamp=$(date +%Y%m%d-%H%M)
  su postgres -c "pg_dump -Fc groma" > "$BACK/groma-$stamp.dump"
  ( cd "$GROMA_HOME" && find artefacts -type f -printf '%s\t%p\n' 2>/dev/null | gzip > "$BACK/artefacts-$stamp.manifest.gz" )
  ls -t "$BACK"/groma-*.dump | tail -n +15 | xargs -r rm -f   # keep the last 14
  green "backup written: $BACK/groma-$stamp.dump ($(du -h "$BACK/groma-$stamp.dump" | cut -f1))"
}
cmd_restore() {
  local f="${1:-}"; [ -f "$f" ] || { red "usage: groma-ctl restore <backups/groma-YYYYMMDD-HHMM.dump>"; return 2; }
  echo "This replaces the database with $f. The api and worker stop while it runs."
  read -r -p "type RESTORE to continue: " ans; [ "$ans" = "RESTORE" ] || { echo "aborted"; return 1; }
  cmd_stop api worker
  su postgres -c "dropdb --if-exists groma && createdb -O groma groma && pg_restore -d groma --no-owner --role=groma '$f'"
  cmd_start api worker; green "restored from $f"
}
cmd_backup_install() {
  command -v crontab >/dev/null || { red "cron is not installed (apt-get install cron), so the nightly backup cannot be scheduled"; return 1; }
  # grep exits 1 on an empty crontab; under pipefail that would abort the install.
  ( crontab -l 2>/dev/null | grep -v 'groma-ctl backup' || true; echo "30 3 * * * /usr/local/bin/groma-ctl backup >> $LOGS/backup.log 2>&1" ) | crontab -
  pgrep -x cron >/dev/null || (cron 2>/dev/null || service cron start >/dev/null 2>&1 || true)
  green "nightly backup at 03:30 installed (crontab -l to see it)"
}
cmd_users() { cd "$APP" && uv run groma users "$@"; }
cmd_disk() {
  df -h "$GROMA_HOME" | awk 'NR==2{print "data disk: "$4" free of "$2" ("$5" used)"}'
  du -sh "$GROMA_HOME"/artefacts "$GROMA_HOME"/backups "$GROMA_HOME"/data 2>/dev/null | sed 's/^/  /'
  if [ -n "${1:-}" ]; then echo "a survey of ${1} GB of images needs about $(( ${1} * 8 )) GB free while it processes (ODM intermediates run 5-10x input)"; fi
}
cmd_gpu() {
  if command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1; then nvidia-smi --query-gpu=name,memory.total,memory.used,utilization.gpu --format=csv; echo "ODM will use CUDA feature extraction (gpu-prod)."; else echo "no GPU in this instance mode: ODM runs on CPU (prod); reconstruction is slower but works."; fi
}
cmd_where() {
  cat <<EOM
GROMA_HOME  $GROMA_HOME
code        $APP   (branch $(git -C "$APP" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?'), commit $(git -C "$APP" rev-parse --short HEAD 2>/dev/null || echo '?'))
settings    /etc/groma.env (root-only)
logs        $LOGS   (api.log worker.log postgres.log redis.log nginx.log nginx-access.log)
service     http://127.0.0.1:$GROMA_PORT   (health: /api/health, docs: /api/docs)
backups     $BACK
EOM
}
cmd_help() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-help}" in
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  status)  cmd_status ;;
  health)  cmd_health ;;
  logs)    shift; cmd_logs "$@" ;;
  follow)  shift; cmd_follow "$@" ;;
  update)  cmd_update ;;
  smoke)   cmd_smoke ;;
  test)    cmd_test ;;
  backup)  cmd_backup ;;
  restore) shift; cmd_restore "$@" ;;
  backup-install) cmd_backup_install ;;
  users)   shift; cmd_users "$@" ;;
  disk)    shift; cmd_disk "$@" ;;
  gpu)     cmd_gpu ;;
  where)   cmd_where ;;
  help|-h|--help) cmd_help ;;
  *) red "unknown command: $1"; cmd_help; exit 2 ;;
esac
